# ── local-vault 配置：复制本文件为同目录的 .env 再填 ──

# 必填：两个目录（绝对路径，~ 可用）
KB_SOURCE_DIR=~/path/to/raw-files          # 你拖入原始文件（PDF/Office/Excel/图片/md/...）的目录
KB_TARGET_DIR=~/path/to/markdown-vault     # 产出 .md 的 Obsidian / Markdown vault 目录

# 可选：孤儿暂存 + 日志目录（不填用默认）
# KB_ORPHANED_DIR=~/path/to/orphaned
# KB_LOG_DIR=~/path/to/logs

# 可选：MinerU JWT token —— 只在处理老 .doc/.ppt、.html、扫描件 PDF、图片时才需要。
# 来源 https://mineru.net 控制台。不填则这些类型会被跳过，并在 sync 末尾醒目提示。
# MINERU_TOKEN=your_jwt_token_here
